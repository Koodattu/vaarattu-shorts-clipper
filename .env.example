# Copy to .env in this project directory and fill only the keys you use.
# Restart the app after editing. Existing process environment variables win.
# Values are single-line literals; optional surrounding quotes are removed.
# No variable expansion, shell commands or backslash escapes are evaluated.

GEMINI_API_KEY=
OPENAI_API_KEY=
ZAI_API_KEY=
DEEPSEEK_API_KEY=

# Optional Hugging Face token for model downloads that require authentication.
HF_TOKEN=

# Enable YouTube Data API v3 for this key. Use a channel ID, not an @handle.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=UCUCV40VqBZqt83afjbbICvw
